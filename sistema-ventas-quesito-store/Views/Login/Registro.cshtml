@model sistema_ventas_quesito_store.ViewModels.RegistroViewModel
@{ Layout = null; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Crear Cuenta — Quesito Store</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<link rel="stylesheet" href="~/css/store.css"/>
<style>
  body{background:var(--qs-bg);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem 0}
  .login-card{background:#fff;border:1px solid #eee;border-radius:12px;width:100%;max-width:460px;padding:2.5rem;box-shadow:0 6px 24px rgba(77,56,29,.1)}
  .login-card .form-control,.login-card .form-select{background:#faf6ee;border:1px solid #ddd0b8;color:var(--qs-text)}
  .login-card .form-control:focus,.login-card .form-select:focus{background:#fff;border-color:var(--qs-yellow);color:var(--qs-text);box-shadow:0 0 0 .2rem rgba(243,183,53,.35)}
  .login-card .form-label{color:var(--qs-muted);font-size:.88rem}
</style>
</head><body class="qs-body">
<div class="login-card">
  <div class="text-center mb-4">
    <a href="/" class="text-decoration-none qs-brand justify-content-center">QUESITO<span>STORE</span></a>
    <p class="text-muted small mt-1">Crea tu cuenta</p>
  </div>
  <form asp-action="Registro" method="post">
    <div class="mb-3">
      <label asp-for="NombreCompleto" class="form-label">Nombre completo</label>
      <input asp-for="NombreCompleto" class="form-control" />
      <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
    </div>
    <div class="row">
      <div class="col mb-3">
        <label asp-for="DNI" class="form-label">DNI</label>
        <input asp-for="DNI" class="form-control" />
        <span asp-validation-for="DNI" class="text-danger small"></span>
      </div>
      <div class="col mb-3">
        <label asp-for="Celular" class="form-label">Celular</label>
        <input asp-for="Celular" class="form-control" />
        <span asp-validation-for="Celular" class="text-danger small"></span>
      </div>
    </div>
    <div class="mb-3">
      <label asp-for="Direccion" class="form-label">Dirección</label>
      <input asp-for="Direccion" class="form-control" />
    </div>
    <div class="mb-3">
      <label asp-for="Correo" class="form-label">Correo</label>
      <input asp-for="Correo" class="form-control" />
      <span asp-validation-for="Correo" class="text-danger small"></span>
    </div>
    <div class="mb-3">
      <label asp-for="Contrasena" class="form-label">Contraseña</label>
      <input asp-for="Contrasena" type="password" class="form-control" />
      <span asp-validation-for="Contrasena" class="text-danger small"></span>
    </div>
    <div class="mb-3">
      <label asp-for="ConfirmarContrasena" class="form-label">Confirmar contraseña</label>
      <input asp-for="ConfirmarContrasena" type="password" class="form-control" />
      <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
    </div>
    <div class="mb-4">
      <label asp-for="IdRol" class="form-label">Rol</label>
      <select asp-for="IdRol" class="form-select" asp-items="@(new SelectList(Model.Roles, "IdRol", "NombreRol"))">
        <option value="">-- Selecciona un rol --</option>
      </select>
      <span asp-validation-for="IdRol" class="text-danger small"></span>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <button type="submit" class="btn btn-qs-primary w-100 py-2"><i class="bi bi-person-plus me-2"></i>Registrarse</button>
  </form>
  <p class="text-center text-muted small mt-3 mb-0">
    ¿Ya tienes cuenta? <a asp-controller="Login" asp-action="Index" style="color:#8a5a1e;font-weight:600">Inicia sesión</a>
  </p>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body></html>