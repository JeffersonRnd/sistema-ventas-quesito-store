@{ Layout = null; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Ingresar — Quesito Store</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<link rel="stylesheet" href="~/css/store.css"/>
<style>
  body{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--qs-bg)}
  .login-card{background:#fff;border:1px solid #eee;border-radius:12px;width:100%;max-width:400px;padding:2.5rem;box-shadow:0 6px 24px rgba(77,56,29,.1)}
  .login-card .form-control{background:#faf6ee;border:1px solid #ddd0b8;color:var(--qs-text)}
  .login-card .form-control:focus{background:#fff;border-color:var(--qs-yellow);color:var(--qs-text);box-shadow:0 0 0 .2rem rgba(243,183,53,.35)}
  .login-card .form-label{color:var(--qs-muted);font-size:.88rem}
</style>
</head><body class="qs-body">
<div class="login-card">
  <div class="text-center mb-4">
    <a href="/" class="text-decoration-none qs-brand justify-content-center">QUESITO<span>STORE</span></a>
    <p class="text-muted small mt-1">Ingresa con tu cuenta</p>
  </div>
  @if(TempData["Mensaje"] != null){<div class="alert alert-success py-2 small">@TempData["Mensaje"]</div>}
  @if(ViewData.ModelState.ErrorCount > 0){
    <div class="alert alert-danger py-2 small">
      @foreach(var e in ViewData.ModelState.Values.SelectMany(v=>v.Errors)){<div>@e.ErrorMessage</div>}
    </div>
  }
  <form method="post" action="/Login/Index">
    <div class="mb-3">
      <label class="form-label">Correo</label>
      <input type="text" name="Correo" class="form-control" placeholder="correo@ejemplo.com" autocomplete="email"/>
    </div>
    <div class="mb-4">
      <label class="form-label">Contraseña</label>
      <input type="password" name="Contrasena" class="form-control" placeholder="••••••••" autocomplete="current-password"/>
    </div>
    <button type="submit" class="btn btn-qs-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-2"></i>Ingresar</button>
  </form>
  <p class="text-center text-muted small mt-3 mb-0">
    ¿No tienes cuenta? <a asp-controller="Login" asp-action="Registro" style="color:#8a5a1e;font-weight:600">Regístrate</a>
  </p>
  <p class="text-center mt-2"><a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i>Volver al inicio</a></p>
</div>
<footer class="qs-footer">
  <div class="container small">&copy; 2026 - <strong>Quesito Store</strong>, Cajamarca</div>
</footer>
</body></html>
