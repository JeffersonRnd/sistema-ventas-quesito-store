@model sistema_ventas_quesito_store.ViewModels.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Quesito Store - Iniciar Sesión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-sm-5">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white text-center">
                    <h5 class="mb-0">🧢 Quesito Store — Iniciar Sesión</h5>
                </div>
                <div class="card-body">
                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success">@TempData["Mensaje"]</div>
                    }
                    <form asp-action="Index" method="post">
                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">Correo</label>
                            <input asp-for="Correo" class="form-control" placeholder="correo@ejemplo.com" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label">Contraseña</label>
                            <input asp-for="Contrasena" class="form-control" placeholder="••••••" />
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark">Ingresar</button>
                        </div>
                    </form>
                    <hr />
                    <p class="text-center mb-0">
                        ¿No tienes cuenta?
                        <a asp-controller="Login" asp-action="Registro">Regístrate</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
