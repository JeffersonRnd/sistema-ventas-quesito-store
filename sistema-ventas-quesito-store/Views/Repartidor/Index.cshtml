@model IEnumerable<sistema_ventas_quesito_store.Models.Entrega>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Panel Repartidor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container mt-4">
        <div class="d-flex justify-content-between mb-3">
            <h4>🚚 Módulo Repartidor</h4>
            <a asp-controller="Login" asp-action="Salir" class="btn btn-outline-danger btn-sm">Salir</a>
        </div>
        @foreach (var e in Model)
        {
            var tipo = e.Pedido?.TipoEntrega?.Nombre ?? "";
            var esDomicilio = tipo.Contains("domicilio");
            string[] estados = esDomicilio
              ? new[] { "Recogido en tienda", "Saliendo de tienda", "En camino", "En la dirección indicada", "Entregado" }
              : new[] { "Recogido en tienda", "Saliendo de tienda", "En camino a empresa de envío", "Entregado a empresa de envío", "Salió de Cajamarca", "En tránsito", "Llegó a ciudad destino", "En espera de entrega", "Entregado", "Finalizado" };
            <div class="card mb-3 shadow-sm">
                <div class="card-header"><b>Pedido #@e.IdPedido</b> — @e.Pedido?.Cliente?.NombreCompleto</div>
                <div class="card-body">
                    <p>Tipo: @tipo | Destino: @(e.DireccionDestino ?? "Tienda")</p>
                    @if (e.EstadosEntrega.Any())
                    {
                        <p class="small text-muted">Último estado: @e.EstadosEntrega.OrderByDescending(x => x.FechaHora).First().Estado</p>
                    }
                    <form asp-action="ActualizarEstado" method="post">
                        <input type="hidden" name="idEntrega" value="@e.IdEntrega" />
                        <div class="row g-2">
                            <div class="col-md-5">
                                <select name="nuevoEstado" class="form-select form-select-sm">
                                    @foreach (var s in estados)
                                    {
                                        <option>@s</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <input type="text" name="observacion" class="form-control form-control-sm" placeholder="Observación (opcional)" />
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-primary btn-sm w-100">Actualizar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="alert alert-info">No hay entregas pendientes.</div>
        }
    </div>
</body></html>