@model IEnumerable<sistema_ventas_quesito_store.Models.Entrega>
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Panel Repartidor</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<style>
  *{font-family:"Segoe UI",sans-serif}
  .qs-nav{background:#111;padding:.85rem 1.5rem;display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #e63946}
  .qs-brand{font-weight:900;letter-spacing:2px;font-size:1.2rem;color:#fff;text-decoration:none}.qs-brand span{color:#e63946}
  body{background:#f4f5f7}.card{border:none;border-radius:10px;box-shadow:0 1px 6px rgba(0,0,0,.08)}
  .btn-qs{background:#e63946;color:#fff;border:none;font-weight:600}.btn-qs:hover{background:#c1121f;color:#fff}
  .timeline{border-left:3px solid #e63946;padding-left:1rem;margin-top:.5rem}
  .tl-item{position:relative;margin-bottom:.4rem;font-size:.8rem}
  .tl-item::before{content:"";position:absolute;left:-1.45rem;top:.25rem;width:10px;height:10px;border-radius:50%;background:#e63946;border:2px solid #fff}
  option:disabled{color:#aaa}
</style>
</head>
<body>
<nav class="qs-nav">
  <a class="qs-brand" href="#">QUESITO<span>STORE</span> <small class="fw-normal text-muted ms-2" style="font-size:.8rem;letter-spacing:0">Repartidor</small></a>
  <div class="d-flex gap-2">
    <a asp-controller="Welcome" asp-action="Repartidor" class="btn btn-sm btn-outline-light"><i class="bi bi-house me-1"></i>Panel</a>
    <a asp-action="Historial" class="btn btn-sm btn-outline-light"><i class="bi bi-clock-history me-1"></i>Historial</a>
    <a asp-controller="Login" asp-action="Salir" class="btn btn-sm btn-outline-danger">Salir</a>
  </div>
</nav>
<div class="container-fluid px-4 mt-4">
  <div class="d-flex align-items-center mb-3 gap-2">
    <i class="bi bi-truck text-danger fs-4"></i>
    <span class="fw-bold fs-5">Entregas Pendientes</span>
  </div>

  @foreach(var e in Model){
    var tipo = e.Pedido?.TipoEntrega?.Nombre ?? "";
    var esDomicilio = tipo.Contains("domicilio");
    var estadosUsados = e.EstadosEntrega.Select(s => s.Estado).ToHashSet();
    string[] todosEstados = esDomicilio
      ? new[]{"Recogido en tienda","Saliendo de tienda","En camino","En la dirección indicada","Entregado"}
      : new[]{"Recogido en tienda","Saliendo de tienda","En camino a empresa de envío","Entregado a empresa de envío","Salió de Cajamarca","En tránsito","Llegó a ciudad destino","En espera de entrega","Entregado","Finalizado"};
    var disponibles = todosEstados.Where(s => !estadosUsados.Contains(s)).ToArray();
    var ultimo = e.EstadosEntrega.OrderByDescending(s => s.FechaHora).FirstOrDefault();

    <div class="card mb-3">
      <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <div>
          <span class="fw-bold">Pedido #@e.IdPedido</span>
          <span class="ms-2 small text-muted">@e.Pedido?.Cliente?.NombreCompleto</span>
        </div>
        <span class="badge @(esDomicilio?"bg-primary":"bg-warning text-dark") small">
          <i class="bi @(esDomicilio?"bi-house":"bi-send") me-1"></i>@tipo
        </span>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <p class="small mb-1"><i class="bi bi-geo-alt me-1 text-muted"></i><b>Destino:</b> @(e.DireccionDestino ?? "A definir")</p>
            @if(ultimo != null){
              <p class="small mb-1 text-muted"><i class="bi bi-info-circle me-1"></i>Último: <b>@ultimo.Estado</b></p>
            }
            @if(e.EstadosEntrega.Any()){
              <div class="timeline mt-2">
                @foreach(var s in e.EstadosEntrega.OrderBy(x=>x.FechaHora)){
                  <div class="tl-item"><b>@s.Estado</b> — @s.FechaHora.ToString("dd/MM HH:mm")
                    @if(!string.IsNullOrEmpty(s.Observacion)){<span class="text-muted"> (@s.Observacion)</span>}
                  </div>
                }
              </div>
            }
          </div>
          <div class="col-md-6">
            @if(disponibles.Any()){
              <form asp-action="ActualizarEstado" method="post">
                <input type="hidden" name="idEntrega" value="@e.IdEntrega"/>
                <div class="mb-2">
                  <label class="form-label small fw-semibold">Siguiente estado</label>
                  <select name="nuevoEstado" class="form-select form-select-sm">
                    @foreach(var s in disponibles){
                      <option value="@s">@s</option>
                    }
                  </select>
                </div>
                <div class="mb-2">
                  <input type="text" name="observacion" class="form-control form-control-sm" placeholder="Observación (opcional)"/>
                </div>
                <button class="btn btn-qs btn-sm w-100"><i class="bi bi-check2 me-1"></i>Registrar Estado</button>
              </form>
            } else {
              <div class="alert alert-success py-2 small text-center mb-0">
                <i class="bi bi-check-circle me-1"></i>Entrega completada
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  }
  @if(!Model.Any()){
    <div class="card p-4 text-center text-muted">
      <i class="bi bi-inbox fs-1 mb-2"></i><p class="mb-0">No hay entregas pendientes.</p>
    </div>
  }
</div>
</body></html>
