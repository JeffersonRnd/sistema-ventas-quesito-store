@model IEnumerable<sistema_ventas_quesito_store.Models.Entrega>
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Historial Repartidor</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<link rel="stylesheet" href="~/css/store.css"/>
<style>
  body{background:var(--qs-bg)}.card{border:none;border-radius:10px;box-shadow:0 1px 6px rgba(0,0,0,.08)}
  .timeline{border-left:3px solid var(--qs-yellow);padding-left:1rem;margin-top:.5rem}
  .tl-item{position:relative;margin-bottom:.4rem;font-size:.8rem}
  .tl-item::before{content:"";position:absolute;left:-1.45rem;top:.25rem;width:10px;height:10px;border-radius:50%;background:var(--qs-yellow-dark);border:2px solid #fff}
</style>
</head>
<body>
<nav class="qs-nav">
  <a class="qs-brand" href="#">QUESITO<span>STORE</span> <small class="fw-normal ms-2" style="font-size:.8rem;letter-spacing:0">Historial</small></a>
  <div class="d-flex gap-2">
    <a asp-action="Index" class="btn btn-qs-nav btn-sm"><i class="bi bi-arrow-left me-1"></i>Pendientes</a>
    <a asp-controller="Login" asp-action="Salir" class="btn btn-qs-danger btn-sm">Salir</a>
  </div>
</nav>
<div class="container-fluid px-4 mt-4">
  <div class="d-flex align-items-center mb-3 gap-2">
    <i class="bi bi-clock-history fs-4" style="color:var(--qs-dark)"></i>
    <span class="fw-bold fs-5">Historial de Entregas</span>
  </div>
  @foreach(var e in Model){
    var tipo = e.Pedido?.TipoEntrega?.Nombre ?? "";
    <div class="card mb-2">
      <div class="card-body py-2">
        <div class="row align-items-start">
          <div class="col-md-5">
            <span class="fw-bold">Pedido #@e.IdPedido</span>
            <span class="ms-2 small text-muted">@e.Pedido?.Cliente?.NombreCompleto</span>
            <div class="small text-muted mt-1"><i class="bi bi-geo-alt me-1"></i>@(e.DireccionDestino ?? "—")</div>
            <span class="badge bg-success mt-1">Finalizado</span>
          </div>
          <div class="col-md-7">
            <div class="timeline">
              @foreach(var s in e.EstadosEntrega.OrderBy(x=>x.FechaHora)){
                <div class="tl-item"><b>@s.Estado</b> <span class="text-muted">@s.FechaHora.ToString("dd/MM HH:mm")</span>
                  @if(!string.IsNullOrEmpty(s.Observacion)){<span class="text-muted"> — @s.Observacion</span>}
                </div>
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  }
  @if(!Model.Any()){
    <div class="card p-4 text-center text-muted">
      <i class="bi bi-inbox fs-1 mb-2"></i><p>Sin historial aún.</p>
    </div>
  }
</div>
</body></html>
