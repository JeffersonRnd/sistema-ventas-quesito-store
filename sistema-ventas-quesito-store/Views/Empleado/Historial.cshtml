@model IEnumerable<sistema_ventas_quesito_store.Models.Pedido>
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Historial Empleado</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<style>
  *{font-family:"Segoe UI",sans-serif}
  .qs-nav{background:#111;padding:.85rem 1.5rem;display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #e63946}
  .qs-brand{font-weight:900;letter-spacing:2px;font-size:1.2rem;color:#fff;text-decoration:none}.qs-brand span{color:#e63946}
  body{background:#f4f5f7}.card{border:none;border-radius:10px;box-shadow:0 1px 6px rgba(0,0,0,.08)}
</style>
</head>
<body>
<nav class="qs-nav">
  <a class="qs-brand" href="#">QUESITO<span>STORE</span> <small class="fw-normal text-muted ms-2" style="font-size:.8rem;letter-spacing:0">Historial</small></a>
  <div class="d-flex gap-2">
    <a asp-action="Index" class="btn btn-sm btn-outline-light"><i class="bi bi-arrow-left me-1"></i>Pendientes</a>
    <a asp-controller="Login" asp-action="Salir" class="btn btn-sm btn-outline-danger">Salir</a>
  </div>
</nav>
<div class="container-fluid px-4 mt-4">
  <div class="d-flex align-items-center mb-3 gap-2">
    <i class="bi bi-clock-history text-danger fs-4"></i>
    <span class="fw-bold fs-5">Historial de Empaque</span>
  </div>
  @foreach(var p in Model){
    <div class="card mb-2">
      <div class="card-body py-2">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <span class="fw-bold">Pedido #@p.IdPedido</span>
            <span class="ms-2 small text-muted">@p.Cliente?.NombreCompleto</span>
            <span class="ms-2 small text-muted"><i class="bi bi-truck me-1"></i>@p.TipoEntrega?.Nombre</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="small text-muted">@p.FechaPedido.ToString("dd/MM/yyyy")</span>
            <span class="badge @(p.EstadoPedido=="Finalizado"?"bg-success":"bg-secondary")">@p.EstadoPedido</span>
          </div>
        </div>
        <ul class="mb-0 small mt-1 text-muted">
          @foreach(var d in p.Detalles){
            <li>@d.Producto?.Nombre x@d.Cantidad</li>
          }
        </ul>
      </div>
    </div>
  }
  @if(!Model.Any()){
    <div class="card p-4 text-center text-muted">
      <i class="bi bi-inbox fs-1 mb-2"></i><p>Sin historial aún.</p>
    </div>
  }
</div>
</body></html>
