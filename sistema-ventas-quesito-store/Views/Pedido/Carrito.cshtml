@model sistema_ventas_quesito_store.Models.Carrito?
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"/><title>Carrito</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/></head>
<body class="bg-light">
<div class="container mt-4" style="max-width:700px">
  <h4>🛒 Mi Carrito</h4>
  @if(Model == null || !Model.Detalles.Any()){
    <div class="alert alert-info">Tu carrito está vacío. <a asp-action="Catalogo">Ver catálogo</a></div>
  } else {
    <table class="table bg-white shadow-sm">
      <thead><tr><th>Producto</th><th>Precio</th><th>Cant.</th><th>Subtotal</th></tr></thead>
      <tbody>
      @foreach(var d in Model.Detalles){
        <tr>
          <td>@d.Producto?.Nombre</td>
          <td>S/ @d.Producto?.Precio.ToString("0.00")</td>
          <td>@d.Cantidad</td>
          <td>S/ @((d.Producto!.Precio * d.Cantidad).ToString("0.00"))</td>
        </tr>
      }
      </tbody>
      <tfoot><tr><td colspan="3" class="fw-bold text-end">Total:</td>
        <td class="fw-bold">S/ @Model.Detalles.Sum(d=>d.Producto!.Precio*d.Cantidad).ToString("0.00")</td></tr></tfoot>
    </table>
    <form asp-action="ConfirmarPedido" method="post">
      <div class="mb-2">
        <label>Tipo de entrega</label>
        <select name="idTipoEntrega" asp-items="ViewBag.TiposEntrega" class="form-select" id="tipoEntrega" onchange="toggleDireccion(this)">
          <option value="">-- Seleccionar --</option>
        </select>
      </div>
      <div class="mb-2" id="divDireccion" style="display:none">
        <label>Dirección de entrega</label>
        <input type="text" name="direccionDestino" class="form-control" placeholder="Dirección completa"/>
      </div>
      <button class="btn btn-success">✔ Confirmar Pedido</button>
      <a asp-action="Catalogo" class="btn btn-secondary">← Seguir comprando</a>
    </form>
    <script>
      function toggleDireccion(sel){
        document.getElementById('divDireccion').style.display = sel.value > 1 ? 'block' : 'none';
      }
    </script>
  }
</div>
</body></html>