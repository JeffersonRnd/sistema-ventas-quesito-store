@model sistema_ventas_quesito_store.Models.Carrito?
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mi Carrito — Quesito Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/store.css" />
    <script src="~/js/site.js"></script>
</head>
<body class="qs-body">
    <header class="qs-header">
        <div class="qs-topbar">
            <a class="qs-brand" href="#"><i class="bi bi-bag-heart-fill" style="color:#4d381d"></i>QUESITO<span>STORE</span></a>
            <div class="qs-nav-links">
                <a asp-action="Catalogo" class="btn btn-qs-outline btn-sm"><i class="bi bi-arrow-left me-1"></i>Seguir comprando</a>
            </div>
        </div>
    </header>

    <div class="container my-4" style="max-width:900px">
        <h2 class="qs-section-title"><i class="bi bi-cart3"></i>Mi carrito</h2>

        @if (TempData["ErrorPedido"] != null)
        {
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["ErrorPedido"]</div>
        }

        @if (Model == null || !Model.Detalles.Any())
        {
            <div class="qs-panel p-5 text-center">
                <i class="bi bi-cart-x fs-1 text-muted"></i>
                <p class="text-muted mt-2 mb-3">Tu carrito está vacío</p>
                <a asp-action="Catalogo" class="btn btn-qs-primary">Ir al catálogo</a>
            </div>
        }
        else
        {
            <div class="qs-panel p-0 mb-3 overflow-hidden">
                <table class="table mb-0 align-middle qs-table-stack">
                    <thead style="background:#fafbfc"><tr><th>Producto</th><th>Talla</th><th>Precio</th><th style="width:140px">Cant.</th><th>Subtotal</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.Detalles)
                        {
                            <tr>
                                <td data-label="Producto" class="fw-semibold">@d.Producto?.Nombre</td>
                                <td data-label="Talla">
                                    @if (!string.IsNullOrEmpty(d.TallaSeleccionada))
                                    {
                                        <span class="badge bg-dark">@d.TallaSeleccionada</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td data-label="Precio">S/ @d.Producto?.Precio.ToString("0.00")</td>
                                <td data-label="Cantidad">
                                    <form asp-action="ActualizarCantidadCarrito" method="post" class="d-flex gap-1 justify-content-end">
                                        <input type="hidden" name="idDetalle" value="@d.IdCarritoDetalle" />
                                        <input type="number" name="cantidad" value="@d.Cantidad" min="1" class="form-control form-control-sm" style="width:65px" />
                                        <button class="btn btn-qs-outline btn-sm" title="Actualizar cantidad"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                </td>
                                <td data-label="Subtotal" class="qs-price">S/ @((d.Producto!.Precio * d.Cantidad).ToString("0.00"))</td>
                                <td data-label="Quitar" class="qs-td-actions">
                                    <form asp-action="EliminarDelCarrito" method="post" onsubmit="return confirm('¿Eliminar este producto del carrito?');">
                                        <input type="hidden" name="idDetalle" value="@d.IdCarritoDetalle" />
                                        <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash3 me-1"></i>Quitar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="qs-panel p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold fs-5">Total a pagar</span>
                    <span class="qs-price fs-4">S/ @Model.Detalles.Sum(d => d.Producto!.Precio * d.Cantidad).ToString("0.00")</span>
                </div>
                <form asp-action="ConfirmarPedido" method="post" id="formPedido" onsubmit="return validarPedido();">
                    <div class="mb-2">
                        <label class="fw-semibold form-label">Tipo de entrega</label>
                        <select name="idTipoEntrega" asp-items="ViewBag.TiposEntrega" class="form-select" id="tipoEntrega" onchange="toggleDireccion(this)">
                            <option value="">-- Seleccionar --</option>
                        </select>
                    </div>
                    <div class="mb-3" id="divDireccion" style="display:none">
                        <label class="fw-semibold form-label">Dirección de entrega</label>
                        <input type="text" name="direccionDestino" id="direccionDestino" class="form-control" placeholder="Dirección completa" />
                    </div>

                    <p class="qs-form-section mt-4"><i class="bi bi-credit-card-fill"></i>Pago con tarjeta</p>
                    <div class="form-text mb-2"><i class="bi bi-shield-lock me-1"></i>Pago simulado: no se procesa ningún cobro real ni se guarda tu número completo.</div>
                    <div class="row g-2 mb-2">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Nombre del titular</label>
                            <input type="text" id="titularTarjeta" name="titularTarjeta" class="form-control" placeholder="Como aparece en la tarjeta" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Número de tarjeta</label>
                            <input type="text" id="numeroTarjeta" name="numeroTarjeta" class="form-control" placeholder="0000 0000 0000 0000" inputmode="numeric" maxlength="19" oninput="formatearTarjeta(this)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Vencimiento</label>
                            <input type="text" id="vencimientoTarjeta" name="vencimientoTarjeta" class="form-control" placeholder="MM/AA" maxlength="5" oninput="formatearVencimiento(this)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">CVV</label>
                            <input type="text" id="cvvTarjeta" name="cvvTarjeta" class="form-control" placeholder="123" inputmode="numeric" maxlength="4" oninput="this.value=this.value.replace(/\D/g,'')" />
                        </div>
                    </div>

                    <button class="btn btn-qs-primary w-100 py-2 mt-3"><i class="bi bi-check-circle me-1"></i>Pagar y confirmar pedido</button>
                </form>
            </div>
            <script>
                        function toggleDireccion(sel) {
                            document.getElementById('divDireccion').style.display = sel.value > 1 ? 'block' : 'none';
                        }
                        function formatearTarjeta(input) {
                            input.value = input.value.replace(/\D/g, '').slice(0, 19).replace(/(.{4})/g, '$1 ').trim();
                        }
                        function formatearVencimiento(input) {
                            let v = input.value.replace(/\D/g, '').slice(0, 4);
                            input.value = v.length > 2 ? v.slice(0, 2) + '/' + v.slice(2) : v;
                        }
                        function validarPedido() {
                            var tipo = document.getElementById('tipoEntrega').value;
                            if (!tipo) { qsToast('Por favor seleccione el tipo de entrega.', 'error'); return false; }
                            if (tipo > 1) {
                                var dir = document.getElementById('direccionDestino').value.trim();
                                if (!dir) { qsToast('Por favor ingrese la dirección de entrega.', 'error'); return false; }
                            }
                            var titular = document.getElementById('titularTarjeta').value.trim();
                            var numero = document.getElementById('numeroTarjeta').value.replace(/\s/g, '');
                            var venc = document.getElementById('vencimientoTarjeta').value.trim();
                            var cvv = document.getElementById('cvvTarjeta').value.trim();
                            if (!titular) { qsToast('Ingresa el nombre del titular de la tarjeta.', 'error'); return false; }
                            if (numero.length < 13 || numero.length > 19) { qsToast('Ingresa un número de tarjeta válido.', 'error'); return false; }
                            if (!/^\d{2}\/\d{2}$/.test(venc)) { qsToast('Ingresa el vencimiento en formato MM/AA.', 'error'); return false; }
                            if (cvv.length < 3 || cvv.length > 4) { qsToast('Ingresa un CVV válido.', 'error'); return false; }
                            return true;
                        }
            </script>
        }
    </div>
<footer class="qs-footer">
  <div class="container small">&copy; 2026 - <strong>Quesito Store</strong>, Cajamarca</div>
</footer>
</body>
</html>
