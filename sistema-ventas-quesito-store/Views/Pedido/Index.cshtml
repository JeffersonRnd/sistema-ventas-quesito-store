@model IEnumerable<sistema_ventas_quesito_store.Models.Pedido>
@{ Layout = null; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Pedidos Admin</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<link rel="stylesheet" href="~/css/store.css"/>
<style>
  body{background:var(--qs-bg)}
  .card{border:none;border-radius:10px;box-shadow:0 1px 6px rgba(0,0,0,.08)}
  th{font-size:.78rem;text-transform:uppercase;letter-spacing:.5px;font-weight:700}td{font-size:.88rem;vertical-align:middle}
</style>
</head><body>
<nav class="qs-nav">
  <a class="qs-brand" href="#">QUESITO<span>STORE</span> <small class="fw-normal ms-2" style="font-size:.8rem;letter-spacing:0">Pedidos</small></a>
  <div class="d-flex gap-2">
    <a asp-controller="Welcome" asp-action="Administrador" class="btn btn-qs-nav btn-sm"><i class="bi bi-arrow-left me-1"></i>Panel</a>
    <a asp-controller="Login" asp-action="Salir" class="btn btn-qs-danger btn-sm">Salir</a>
  </div>
</nav>
<div class="container-fluid px-4 mt-4">
  <div class="d-flex align-items-center mb-3 gap-2">
    <i class="bi bi-bag-check fs-4" style="color:var(--qs-dark)"></i>
    <span class="fw-bold fs-5">Gestión de Pedidos</span>
  </div>
  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover mb-0 qs-table-stack">
        <thead class="table-dark"><tr>
          <th class="ps-3">#</th><th>Cliente</th><th>Entrega</th><th>Total</th>
          <th>Estado</th><th>Pago</th><th>Fecha</th><th class="pe-3">Acciones</th>
        </tr></thead>
        <tbody>
        @foreach(var p in Model){
          <tr>
            <td data-label="Pedido" class="ps-3 fw-bold">#@p.IdPedido</td>
            <td data-label="Cliente">@p.Cliente?.NombreCompleto</td>
            <td data-label="Entrega"><span class="badge bg-light text-dark border">@p.TipoEntrega?.Nombre</span></td>
            <td data-label="Total" class="fw-semibold">S/ @p.Total.ToString("0.00")</td>
            <td data-label="Estado">
              @{var sc = p.EstadoPedido switch{"Pendiente"=>"bg-warning text-dark","Aprobado"=>"bg-info text-dark","Empacando"=>"bg-primary","Empacado y listo"=>"bg-success","En despacho"=>"bg-primary","Finalizado"=>"bg-success","Cancelado"=>"bg-danger",_=>"bg-secondary"};}
              <span class="badge @sc">@p.EstadoPedido</span>
            </td>
            <td data-label="Pago"><span class="badge @(p.EstadoPago=="Pagado"?"bg-success":"bg-warning text-dark")">@p.EstadoPago</span></td>
            <td data-label="Fecha" class="text-muted small">@p.FechaPedido.ToString("dd/MM/yy HH:mm")</td>
            <td data-label="Acciones" class="pe-3 qs-td-actions">
              @if(p.EstadoPedido=="Pendiente"){
                <form asp-action="Aprobar" asp-route-id="@p.IdPedido" method="post" style="display:inline">
                  <button class="btn btn-success btn-sm" title="Aprobar pedido"><i class="bi bi-check-lg"></i></button>
                </form>
                <form asp-action="Cancelar" asp-route-id="@p.IdPedido" method="post" style="display:inline">
                  <button class="btn btn-danger btn-sm" title="Cancelar pedido"><i class="bi bi-x-lg"></i></button>
                </form>
              }
              @if(p.EstadoPago=="Pendiente" && p.EstadoPedido!="Cancelado"){
                <form asp-action="MarcarPagado" asp-route-id="@p.IdPedido" method="post" style="display:inline">
                  <button class="btn btn-outline-success btn-sm" title="Marcar pagado"><i class="bi bi-currency-dollar"></i></button>
                </form>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
  @if(!Model.Any()){
    <div class="qs-tip-card mt-3">
      <div class="qs-tip-icon"><i class="bi bi-inbox"></i></div>
      <div><h6>Sin pedidos aún</h6><p>Aquí aparecerán los pedidos que hagan los clientes.</p></div>
    </div>
  }
</div>
<footer class="qs-footer">
  <div class="container small">&copy; 2026 - <strong>Quesito Store</strong>, Cajamarca</div>
</footer>
</body></html>