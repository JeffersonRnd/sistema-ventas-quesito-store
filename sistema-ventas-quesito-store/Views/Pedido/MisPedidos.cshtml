@model IEnumerable<sistema_ventas_quesito_store.Models.Pedido>
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Mis Pedidos</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/></head>
<body class="bg-light">
<div class="container mt-4">
  <div class="d-flex justify-content-between mb-3">
    <h4>📦 Mis Pedidos</h4>
    <a asp-action="Catalogo" class="btn btn-outline-primary btn-sm">← Catálogo</a>
  </div>
  @foreach(var p in Model){
    <div class="card mb-3 shadow-sm">
      <div class="card-header d-flex justify-content-between">
        <span>Pedido #@p.IdPedido — @p.FechaPedido.ToString("dd/MM/yyyy")</span>
        <span class="badge bg-info text-dark">@p.EstadoPedido</span>
      </div>
      <div class="card-body">
        <p>Entrega: <b>@p.TipoEntrega?.Nombre</b>@if(p.EstadoPedido != "Cancelado"){ <text> | Pago: <span class="badge @(p.EstadoPago=="Pagado"?"bg-success":"bg-warning text-dark")">@p.EstadoPago</span></text> }</p>
        <p>Total: <b>S/ @p.Total.ToString("0.00")</b></p>
        @if(p.Entrega?.EstadosEntrega?.Any() == true){
          <p class="mb-1"><b>Historial de entrega:</b></p>
          <ul class="list-group list-group-flush small">
          @foreach(var e in p.Entrega.EstadosEntrega.OrderByDescending(x=>x.FechaHora)){
            <li class="list-group-item py-1">@e.FechaHora.ToString("dd/MM HH:mm") — @e.Estado @(e.Observacion != null ? $"({e.Observacion})" : "")</li>
          }
          </ul>
        }
      </div>
    </div>
  }
</div>
</body></html>