@model IEnumerable<sistema_ventas_quesito_store.Models.Pedido>
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Mis Pedidos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body class="qs-body">
    <header class="qs-header">
        <div class="qs-topbar">
            <a class="qs-brand" href="#"><i class="bi bi-bag-heart-fill" style="color:#4d381d"></i>QUESITO<span>STORE</span></a>
            <div class="qs-nav-links">
                <a asp-action="Catalogo" class="btn btn-qs-outline btn-sm"><i class="bi bi-arrow-left me-1"></i>Catálogo</a>
            </div>
        </div>
    </header>

    <div class="container my-4" style="max-width:800px">
        <h2 class="qs-section-title"><i class="bi bi-box-seam-fill"></i>Mis pedidos</h2>

        @if (!Model.Any())
        {
            <div class="qs-panel p-5 text-center">
                <i class="bi bi-receipt fs-1 text-muted"></i>
                <p class="text-muted mt-2 mb-3">Aún no tienes pedidos</p>
                <a asp-action="Catalogo" class="btn btn-qs-primary">Ir al catálogo</a>
            </div>
        }
        @foreach (var p in Model)
        {
            <div class="qs-order-card">
                <div class="qs-order-header">
                    <span class="fw-semibold"><i class="bi bi-hash"></i>@p.IdPedido — @p.FechaPedido.ToString("dd/MM/yyyy")</span>
                    <span class="badge bg-info text-dark">@p.EstadoPedido</span>
                </div>
                <div class="p-3">
                    <p class="mb-1"><i class="bi bi-truck me-1"></i>Entrega: <b>@p.TipoEntrega?.Nombre</b>
                        @if (p.EstadoPedido != "Cancelado")
                        {
                            <text> &nbsp;|&nbsp; Pago: <span class="badge @(p.EstadoPago == "Pagado" ? "bg-success" : "bg-warning text-dark")">@p.EstadoPago</span></text>
                        }
                    </p>
                    <p class="mb-2">Total: <span class="qs-price">S/ @p.Total.ToString("0.00")</span></p>
                    @if (p.Entrega?.EstadosEntrega?.Any() == true)
                    {
                        <p class="mb-1 fw-semibold small">Historial de entrega:</p>
                        <ul class="list-group list-group-flush small">
                            @foreach (var e in p.Entrega.EstadosEntrega.OrderByDescending(x => x.FechaHora))
                            {
                                <li class="list-group-item py-1">@e.FechaHora.ToString("dd/MM HH:mm") — @e.Estado @(e.Observacion != null ? $"({e.Observacion})" : "")</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </div>
</body>
</html>
