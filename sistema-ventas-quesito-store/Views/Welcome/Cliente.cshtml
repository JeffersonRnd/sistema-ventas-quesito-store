@{ Layout = null; var nombre = ViewBag.Nombre as string; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Mi Cuenta — Quesito Store</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<link rel="stylesheet" href="~/css/store.css"/>
</head><body class="qs-body">
<header class="qs-header"><div class="qs-topbar">
  <a class="qs-brand" href="#">QUESITO<span>STORE</span></a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-dark small d-none d-md-block"><i class="bi bi-person-circle me-1"></i>@nombre</span>
    <a asp-controller="Login" asp-action="Salir" class="btn btn-qs-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
  </div>
</div></header>
<section class="qs-hero"><div class="container"><h1>Hola, @nombre</h1><p>Explora el catálogo y revisa tus pedidos.</p></div></section>
<div class="container">
  <div class="row g-3">
    <div class="col-6 col-md-3">
      <a asp-controller="Pedido" asp-action="Catalogo" class="qs-card p-4 text-decoration-none d-block">
        <div class="qs-cat-tag"><i class="bi bi-bag" style="color:var(--qs-dark);font-size:1.4rem"></i></div>
        <div class="qs-card-title mt-2 text-dark">Catálogo</div>
        <div class="text-muted small">Ver productos</div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a asp-controller="Pedido" asp-action="MisPedidos" class="qs-card p-4 text-decoration-none d-block">
        <div class="qs-cat-tag"><i class="bi bi-receipt" style="color:#8a5a1e;font-size:1.4rem"></i></div>
        <div class="qs-card-title mt-2 text-dark">Mis Pedidos</div>
        <div class="text-muted small">Seguimiento</div>
      </a>
    </div>
  </div>
</div>
</body></html>
