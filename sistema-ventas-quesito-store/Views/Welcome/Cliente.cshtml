@{ Layout = null; var nombre = ViewBag.Nombre as string; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Mi Cuenta — Quesito Store</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<style>
  *{font-family:"Segoe UI",sans-serif}body{background:#f4f5f7}
  .qs-nav{background:#111;padding:.85rem 1.5rem;display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #e63946}
  .qs-brand{font-weight:900;letter-spacing:2px;font-size:1.2rem;color:#fff;text-decoration:none}.qs-brand span{color:#e63946}
  .menu-card{border:none;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.08);transition:transform .15s;text-decoration:none;color:#1a1a1a;display:block}
  .menu-card:hover{transform:translateY(-3px);color:#1a1a1a}
  .menu-icon{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.6rem;margin-bottom:1rem}
</style>
</head><body>
<nav class="qs-nav">
  <a class="qs-brand" href="#">QUESITO<span>STORE</span></a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-muted small"><i class="bi bi-person-circle me-1"></i>@nombre</span>
    <a asp-controller="Login" asp-action="Salir" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
  </div>
</nav>
<div class="container mt-5">
  <p class="text-muted mb-1 small">Mi cuenta</p>
  <h4 class="fw-bold mb-4">Hola, @nombre</h4>
  <div class="row g-3">
    <div class="col-6 col-md-3">
      <a asp-controller="Pedido" asp-action="Catalogo" class="menu-card p-4 bg-white">
        <div class="menu-icon" style="background:#fff0f0"><i class="bi bi-bag" style="color:#e63946"></i></div>
        <div class="fw-bold">Catálogo</div>
        <div class="text-muted small mt-1">Ver productos</div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a asp-controller="Pedido" asp-action="MisPedidos" class="menu-card p-4 bg-white">
        <div class="menu-icon" style="background:#eff6ff"><i class="bi bi-receipt" style="color:#2563eb"></i></div>
        <div class="fw-bold">Mis Pedidos</div>
        <div class="text-muted small mt-1">Seguimiento</div>
      </a>
    </div>
  </div>
</div>
</body></html>
