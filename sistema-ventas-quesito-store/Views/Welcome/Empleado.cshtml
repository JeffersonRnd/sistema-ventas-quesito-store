@{ Layout = null; var nombre = ViewBag.Nombre as string; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Panel Empleado</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark text-center">
            <h4>📦 Panel Empleado — Quesito Store</h4>
        </div>
            <div class="card-body text-center">
                <h5>¡Bienvenido/a, @nombre!</h5>
                <a asp-controller="Empleado" asp-action="Index" class="btn btn-warning mt-3">📦 Ver Pedidos para Empacar</a>
                <br />
                <a asp-controller="Login" asp-action="Salir" class="btn btn-outline-danger mt-2">Cerrar Sesión</a>
            </div>
    </div>
</div>
</body>
</html>
