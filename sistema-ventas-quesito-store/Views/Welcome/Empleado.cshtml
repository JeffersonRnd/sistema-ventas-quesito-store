@{ Layout = null; var nombre = ViewBag.Nombre as string; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Empleado — Quesito Store</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<link rel="stylesheet" href="~/css/store.css"/>
</head><body class="qs-body-alt">
<nav class="qs-nav">
  <a class="qs-brand" href="#">QUESITO<span>STORE</span> <small class="fw-normal ms-2" style="font-size:.8rem;letter-spacing:0">Panel Empleado</small></a>
  <div class="d-flex align-items-center gap-3">
    <span class="small text-white-50"><i class="bi bi-person-circle me-1"></i>@nombre</span>
    <a asp-controller="Login" asp-action="Salir" class="btn btn-qs-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
  </div>
</nav>
<div class="container mt-4">
  <div class="qs-welcome-hero">
    <div>
      <span class="qs-role-badge"><i class="bi bi-box-seam me-1"></i>Empleado</span>
      <h4 class="mt-2"><i class="bi bi-clipboard-check me-2" style="color:var(--qs-yellow)"></i>Bienvenido/a, @nombre</h4>
      <p>Organiza el empaque de pedidos y lleva el control de lo ya preparado.</p>
    </div>
    <div class="qs-welcome-date">
      <div><i class="bi bi-calendar-event me-1"></i><span id="qsFecha"></span></div>
      <div class="mt-1"><i class="bi bi-clock me-1"></i><span id="qsHora"></span></div>
    </div>
  </div>

  <p class="qs-section-title"><i class="bi bi-lightning-charge-fill" style="color:var(--qs-yellow-dark)"></i>Accesos rápidos</p>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
      <a asp-controller="Empleado" asp-action="Index" class="qs-menu-card p-4">
        <div class="qs-menu-icon mb-3"><i class="bi bi-box-seam"></i></div>
        <div class="fw-bold">Empaque</div>
        <div class="text-muted small mt-1">Pedidos pendientes</div>
      <span class="qs-menu-cta">Ver pendientes<i class="bi bi-arrow-right"></i></span>
      </a>
    </div>
    <div class="col-6 col-md-4">
      <a asp-controller="Empleado" asp-action="Historial" class="qs-menu-card p-4">
        <div class="qs-menu-icon mb-3"><i class="bi bi-clock-history"></i></div>
        <div class="fw-bold">Historial</div>
        <div class="text-muted small mt-1">Pedidos empacados</div>
      <span class="qs-menu-cta">Ver historial<i class="bi bi-arrow-right"></i></span>
      </a>
    </div>
  </div>

  <div class="qs-tip-card mb-5">
    <div class="qs-tip-icon"><i class="bi bi-info-circle"></i></div>
    <div>
      <h6>Recordatorio</h6>
      <p>Marca cada pedido como "Empacando" y luego "Listo" para que el repartidor pueda recogerlo sin demoras.</p>
    </div>
  </div>
</div>
<script>
  const qsAhora = new Date();
  document.getElementById('qsFecha').textContent = qsAhora.toLocaleDateString('es-PE', { weekday:'long', day:'numeric', month:'long' });
  document.getElementById('qsHora').textContent = qsAhora.toLocaleTimeString('es-PE', { hour:'2-digit', minute:'2-digit' });
</script>
<footer class="qs-footer">
  <div class="container small">&copy; 2026 - <strong>Quesito Store</strong>, Cajamarca</div>
</footer>
</body></html>
