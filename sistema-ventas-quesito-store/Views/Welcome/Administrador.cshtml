@{ Layout = null; var nombre = ViewBag.Nombre as string; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Panel Administrador</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white text-center">
            <h4>🧢 Panel Administrador — Quesito Store</h4>
        </div>

            <div class="card-body text-center">
                <h5>¡Bienvenido/a, @nombre!</h5>
                <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
                    <a asp-controller="Pedido" asp-action="Index" class="btn btn-outline-dark">📦 Gestionar Pedidos</a>
                    <a asp-controller="Producto" asp-action="Index" class="btn btn-outline-dark">🧢 Gestionar Productos</a>
                </div>
                <a asp-controller="Login" asp-action="Salir" class="btn btn-outline-danger mt-3">Cerrar Sesión</a>
            </div>
        
    </div>
</div>
</body>
</html>
