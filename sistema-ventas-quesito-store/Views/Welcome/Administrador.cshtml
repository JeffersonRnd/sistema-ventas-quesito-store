@{ Layout = null; var nombre = ViewBag.Nombre as string; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Panel Administrador</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white text-center">
            <h4>🧢 Panel Administrador — Quesito Store</h4>
        </div>
        <div class="card-body text-center">
            <h5>¡Bienvenido/a, @nombre!</h5>
            <p class="text-muted">Tienes acceso completo al sistema de gestión de ventas.</p>
            <a asp-controller="Login" asp-action="Salir" class="btn btn-outline-danger mt-2">Cerrar Sesión</a>
        </div>
    </div>
</div>
</body>
</html>
