@{ Layout = null; var nombre = ViewBag.Nombre as string; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Admin — Quesito Store</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
<link rel="stylesheet" href="~/css/store.css"/>
</head><body class="qs-body-alt">
<nav class="qs-nav">
  <a class="qs-brand" href="#">QUESITO<span>STORE</span> <small class="fw-normal ms-2" style="font-size:.8rem;letter-spacing:0">Panel Administrador</small></a>
  <div class="d-flex align-items-center gap-3">
    <span class="small d-none d-md-block text-white-50"><i class="bi bi-person-circle me-1"></i>@nombre</span>
    <a asp-controller="Login" asp-action="Salir" class="btn btn-qs-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
  </div>
</nav>
<div class="container mt-5">
  <p class="text-muted mb-1 small">Panel de administración</p>
  <h4 class="fw-bold mb-4">Bienvenido/a, @nombre</h4>
  <div class="row g-3">
    <div class="col-6 col-md-3">
      <a asp-controller="Pedido" asp-action="Index" class="qs-menu-card p-4">
        <div class="qs-menu-icon mb-3"><i class="bi bi-bag-check"></i></div>
        <div class="fw-bold">Pedidos</div>
        <div class="text-muted small mt-1">Aprobar y gestionar</div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a asp-controller="Producto" asp-action="Index" class="qs-menu-card p-4">
        <div class="qs-menu-icon mb-3"><i class="bi bi-grid"></i></div>
        <div class="fw-bold">Productos</div>
        <div class="text-muted small mt-1">Catálogo y stock</div>
      </a>
    </div>
  </div>
</div>
</body></html>
