@model sistema_ventas_quesito_store.Models.Producto
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"/><title>Nuevo Producto</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/></head>
<body class="bg-light">
<div class="container mt-4" style="max-width:600px">
  <h4>Editar Producto</h4>
  <form asp-action="Editar" method="post">
    <div class="mb-2"><label>Nombre</label><input asp-for="Nombre" class="form-control"/></div>
    <div class="mb-2"><label>Descripción</label><input asp-for="Descripcion" class="form-control"/></div>
    <div class="mb-2"><label>Categoría</label><select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select"><option value="">-- Seleccionar --</option></select></div>
    <div class="row">
      <div class="col mb-2"><label>Talla</label><input asp-for="Talla" class="form-control"/></div>
      <div class="col mb-2"><label>Color</label><input asp-for="Color" class="form-control"/></div>
    </div>
    <div class="row">
      <div class="col mb-2"><label>Precio</label><input asp-for="Precio" type="number" step="0.01" class="form-control"/></div>
      <div class="col mb-2"><label>Stock</label><input asp-for="Stock" type="number" class="form-control"/></div>
    </div>
    <div class="mb-2"><label>URL Imagen</label><input asp-for="ImagenUrl" class="form-control"/></div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
  </form>
</div>
</body></html>