@model sistema_ventas_quesito_store.Models.Producto
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Editar Producto</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <style>
            body {
                background: #f5f5f5;
                font-family: 'Segoe UI',sans-serif;
        }</style>
    </head>
    <body>
        <div class="container mt-4" style="max-width:620px">
            <h5 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2" style="color:#e63946"></i>Editar Producto</h5>
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Editar" method="post" enctype="multipart/form-data">
                        <input asp-for="IdProducto" type="hidden" />
                        <input asp-for="ImagenUrl" type="hidden" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
                            <input asp-for="Nombre" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Categoría <span class="text-danger">*</span></label>
                            <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select"></select>
                        </div>
                        <div class="row">
                            <div class="col mb-3">
                                <label class="form-label fw-semibold">Talla</label>
                                <input asp-for="Talla" class="form-control" />
                            </div>
                            <div class="col mb-3">
                                <label class="form-label fw-semibold">Color</label>
                                <input asp-for="Color" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col mb-3">
                                <label class="form-label fw-semibold">Precio (S/) <span class="text-danger">*</span></label>
                                <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                            </div>
                            <div class="col mb-3">
                                <label class="form-label fw-semibold">Stock <span class="text-danger">*</span></label>
                                <input asp-for="Stock" type="number" class="form-control" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <input asp-for="Activo" type="checkbox" class="form-check-input me-1" /> Activo
                            </label>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Imagen</label>
                            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.ImagenUrl" style="max-height:120px; border-radius:4px; border:1px solid #ddd;" />
                                    <p class="text-muted small mt-1">Imagen actual. Sube una nueva para reemplazarla.</p>
                                </div>
                            }
                            <input type="file" name="imagen" class="form-control" accept="image/*" onchange="previewImg(this)" />
                            <img id="preview" src="#" class="mt-2 d-none rounded" style="max-height:120px; border:1px solid #ddd;" />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn text-white fw-bold" style="background:#e63946">Guardar Cambios</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script>
                function previewImg(input) {
                    const img = document.getElementById('preview');
                    if (input.files && input.files[0]) {
                        img.src = URL.createObjectURL(input.files[0]);
                        img.classList.remove('d-none');
                    }
                }
        </script>
    </body></html>