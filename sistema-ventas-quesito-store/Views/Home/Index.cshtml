@model IEnumerable<sistema_ventas_quesito_store.Models.Producto>
@{ ViewData["Title"] = "Inicio"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quesito Store — Ropa Urbana en Cajamarca</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body class="qs-body">
    <header class="qs-header">
        <div class="qs-topbar">
            <a class="qs-brand" href="#"><i class="bi bi-bag-heart-fill" style="color:#4d381d"></i>QUESITO<span>STORE</span></a>
            <div class="qs-nav-links">
                <span class="small d-none d-md-block text-dark"><i class="bi bi-geo-alt me-1"></i>Cajamarca, Perú</span>
                <button class="btn btn-qs-outline btn-sm" data-bs-toggle="modal" data-bs-target="#modalLogin">
                    <i class="bi bi-person me-1"></i>Ingresar
                </button>
                <a asp-controller="Login" asp-action="Registro" class="btn btn-qs-primary btn-sm">
                    <i class="bi bi-person-plus me-1"></i>Crear cuenta
                </a>
            </div>
        </div>
    </header>

    <section class="qs-hero">
        <div class="container">
            <h1><i class="bi bi-stars me-1"></i>Ropa y calzado urbano en Cajamarca</h1>
            <p>Mira todo el catálogo libremente. Para comprar, crea tu cuenta gratis en un minuto.</p>
        </div>
    </section>

    <div class="container mb-5">
        <div class="d-flex flex-wrap gap-2 mb-4">
            <span class="badge rounded-pill text-dark border px-3 py-2"><i class="bi bi-tag me-1"></i>Gorras</span>
            <span class="badge rounded-pill text-dark border px-3 py-2"><i class="bi bi-tag me-1"></i>Zapatillas</span>
            <span class="badge rounded-pill text-dark border px-3 py-2"><i class="bi bi-tag me-1"></i>Polos</span>
            <span class="badge rounded-pill text-dark border px-3 py-2"><i class="bi bi-tag me-1"></i>Poleras</span>
            <span class="badge rounded-pill text-dark border px-3 py-2"><i class="bi bi-tag me-1"></i>Pantalones</span>
        </div>

        <h2 class="qs-section-title"><i class="bi bi-grid-fill"></i>Productos destacados</h2>
        <div class="qs-grid">
            @foreach (var p in Model)
            {
                <div class="qs-card">
                    <div class="qs-card-img position-relative" @(!string.IsNullOrEmpty(p.ImagenUrl) ? $"onclick=\"verImagen('{p.ImagenUrl}','{p.Nombre}')\"" : "")>
                        <span class="qs-ribbon">DISPONIBLE</span>
                        @if (!string.IsNullOrEmpty(p.ImagenUrl))
                        {
                            <img src="@p.ImagenUrl" alt="@p.Nombre" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-image fs-2"></i></div>
                        }
                    </div>
                    <div class="qs-card-body">
                        <span class="qs-cat-tag">@p.Categoria?.NombreCategoria</span>
                        <div class="qs-card-title">@p.Nombre</div>
                        <div class="qs-price">S/ @p.Precio.ToString("0.00")</div>
                        <div class="qs-stock-note"><i class="bi bi-box-seam me-1"></i>@p.Stock disponibles</div>
                        <div class="qs-card-footer">
                            <button type="button" class="btn btn-qs-primary btn-sm w-100" data-bs-toggle="modal" data-bs-target="#modalLogin">
                                <i class="bi bi-cart-plus me-1"></i>Comprar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-secondary mt-3"><i class="bi bi-info-circle me-1"></i>No hay productos disponibles por el momento.</div>
        }
    </div>

    <section class="py-5" style="background:#fff;border-top:1px solid #eee">
        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <i class="bi bi-truck fs-2" style="color:#4d381d"></i>
                    <h6 class="fw-bold mt-2 mb-1">Envío a todo el Perú</h6>
                    <p class="text-muted small mb-0">Recojo en tienda o envío a domicilio en Cajamarca y otras ciudades.</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-clock-history fs-2" style="color:#4d381d"></i>
                    <h6 class="fw-bold mt-2 mb-1">Seguimiento de tu pedido</h6>
                    <p class="text-muted small mb-0">Consulta el estado de tu compra desde tu cuenta.</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-shield-check fs-2" style="color:#4d381d"></i>
                    <h6 class="fw-bold mt-2 mb-1">Compra segura</h6>
                    <p class="text-muted small mb-0">Pedidos verificados y confirmados por nuestro equipo.</p>
                </div>
            </div>
        </div>
    </section>

    <footer class="qs-footer">
        <strong>Quesito Store</strong> · Cajamarca, Perú · © 2026 Todos los derechos reservados
    </footer>

    <div class="modal fade" id="modalImagen" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="modalImagenTitulo"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="modalImagenSrc" src="" style="max-width:100%;max-height:70vh;" />
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL LOGIN (requerido para comprar) -->
    <div class="modal fade" id="modalLogin" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-circle me-2" style="color:#4d381d"></i>Inicia sesión para comprar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Login" asp-action="Index" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>
                            <input type="text" name="Correo" class="form-control" placeholder="correo@ejemplo.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Contraseña</label>
                            <input type="password" name="Contrasena" class="form-control" placeholder="••••••••" required />
                        </div>
                        @if (TempData["ErrorLogin"] != null)
                        {
                            <div class="alert alert-danger py-2 small">@TempData["ErrorLogin"]</div>
                        }
                    </div>
                    <div class="modal-footer flex-column gap-2">
                        <button type="submit" class="btn btn-qs-primary w-100 py-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
                        </button>
                        <a asp-controller="Login" asp-action="Registro" class="text-muted small">
                            ¿No tienes cuenta? <span style="color:#4d381d">Regístrate gratis</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function verImagen(url, nombre) {
            document.getElementById('modalImagenSrc').src = url;
            document.getElementById('modalImagenTitulo').innerText = nombre;
            new bootstrap.Modal(document.getElementById('modalImagen')).show();
        }
    </script>
</body>
</html>
